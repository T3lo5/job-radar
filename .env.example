# ============================================================================
# Job Radar - Variáveis de ambiente MÍNIMAS
# Copie para .env e ajuste conforme necessário. NUNCA commite o .env real.
#
# Conforme ADR-0005, o .env guarda APENAS o que é crítico e imutável sem
# restart. Configurações editáveis (IA, Telegram, Cron, credenciais de
# fontes) vão na tabela `settings` e são gerenciadas via UI (wizard /setup
# e página /settings). Veja docs/adr/0005-settings-via-ui.md.
# ============================================================================

# Ambiente geral
NODE_ENV=development
LOG_LEVEL=info

# Postgres (docker-compose provisiona automaticamente)
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar
POSTGRES_DB=jobradar
POSTGRES_PORT=5432
DATABASE_URL=postgres://jobradar:jobradar@localhost:5432/jobradar

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API
APP_PORT=3001
APP_HOST=0.0.0.0
API_TARGET=dev

# Web (Vite dev)
WEB_PORT=5173
WEB_PORT_INTERNAL=5173
WEB_HOST=0.0.0.0
WEB_TARGET=dev
WEB_PORT_PROD=8080

# Chave mestra para criptografar settings sensíveis (AES-256-GCM)
# IMPORTANTE: gere uma nova para cada ambiente. Para gerar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Em prod, armazene em cofre (1Password, AWS Secrets Manager, etc).
# Trocar esta chave invalida todos os settings criptografados.
SETTINGS_ENCRYPTION_KEY=

# --- Tudo abaixo disso vai para a tabela `settings` (UI), NÃO para o .env ---
# AI_API_KEY=
# AI_MODEL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# JOB_COLLECTION_CRON=
# DAILY_REPORT_CRON=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# LinkedIn Feed Scrape (opcional)
# Para pegar vagas do mural do LinkedIn, cole os cookies da sua sessão aqui.
# Como obter: no Chrome, acesse linkedin.com, F12 > Application > Cookies > Copie todos os valores
# Formato: "cookie1=valor1; cookie2=valor2; ..."
# LINKEDIN_COOKIES=

# Apify LinkedIn Jobs Scraper (opcional)
# Token da API do Apify para scrape de vagas do LinkedIn
# Crie uma conta em https://apify.com e gere um token em https://console.apify.com/account#/integrations
# Free tier: ~$5 crédito para novos usuários, $1.00 por 1.000 resultados
# APIFY_TOKEN=
