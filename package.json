{
  "name": "job-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema pessoal para descoberta, análise e priorização de vagas de tecnologia",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' build && pnpm -r --filter='./apps/*' build",
    "dev": "pnpm -r --parallel --filter='./apps/*' dev",
    "dev:api": "pnpm --filter @job-radar/api dev",
    "dev:web": "pnpm --filter @job-radar/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.9.0",
    "typescript": "^5.6.3"
  }
}
