{
  "name": "@job-radar/api",
  "version": "0.0.0",
  "private": true,
  "description": "Job Radar API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,json,md}\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@job-radar/shared": "workspace:*",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.0",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "grammy": "^1.34.0",
    "ioredis": "^5.4.2",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@job-radar/eslint-config": "workspace:*",
    "@job-radar/typescript-config": "workspace:*",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.17.6",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.17.0",
    "prettier": "^3.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  },
  "license": "UNLICENSED"
}
